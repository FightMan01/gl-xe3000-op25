#!/bin/sh /etc/rc.common
# Fill /proc/gl-hw-info the way GL's stock kernel does on the XE3000: board
# facts from its device tree, identity from the factory partition.

START=11

FACTORY=/dev/mmcblk0p3
P=/proc/gl-hw-info

put() {
	[ -w "$P/$1" ] && printf '%s' "$2" > "$P/$1"
}

# ASCII field at $1, up to $2 bytes, ending at the first 0xff, NUL or newline.
factory_str() {
	dd if="$FACTORY" bs=1 skip=$(($1)) count="$2" 2>/dev/null |
		tr '\377\000\n' '\n\n\n' | head -n 1
}

start() {
	[ -d "$P" ] || modprobe gl-hw-info 2>/dev/null
	[ -d "$P" ] || return 1

	put model xe3000
	put wan eth0
	put lan eth1
	put build-in-modem "0001:01:00.0,1-1.2"
	put pcie-bus "0001:01:00.0"
	put usb-port "1-1.3"
	put modem-reset 0
	put fan "hwmon0 cooling_device0"
	put flash_size 7456
	put temperature /sys/devices/virtual/thermal/thermal_zone0/temp
	put reset-button gpio-456
	put radio "mt798111 mt798112"
	put mcu "/dev/ttyS1,9600"
	put cfg-partition /dev/mmcblk0p5
	put dfs 1
	put sim dual

	[ -b "$FACTORY" ] || return 0

	put device_mac "$(dd if="$FACTORY" bs=1 skip=$((0x0a)) count=6 2>/dev/null |
		hexdump -v -e '6/1 "%02x:"' | sed 's/:$//')"
	put device_ddns "$(factory_str 0x10 16)"
	put device_sn_bak "$(factory_str 0x20 16)"
	put device_sn "$(factory_str 0x30 16)"
	put country_code "$(factory_str 0x88 2)"

	# Certificate followed by its private key, both PEM.
	local pem
	pem="$(dd if="$FACTORY" bs=4096 skip=1 count=2 2>/dev/null | tr -d '\377\000')"
	put device_cert "$(printf '%s\n' "$pem" |
		sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p')
"
	put device_key "$(printf '%s\n' "$pem" |
		sed -n '/-----BEGIN PRIVATE KEY-----/,/-----END PRIVATE KEY-----/p')
"
}
