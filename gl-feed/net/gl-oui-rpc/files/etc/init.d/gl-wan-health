#!/bin/sh /etc/rc.common
# Independent mwan3 reachability self-heal - see /usr/sbin/gl-wan-health for
# the full rationale (mwan3track can wedge "online" after ifdown/ifup or an
# address change, leaving the router connected-looking but passing nothing).

START=99
STOP=05

USE_PROCD=1

start_service() {
	[ "$(uci -q get gl-wan-health.health.enabled)" = "0" ] && return 0

	procd_open_instance
	procd_set_param command /usr/sbin/gl-wan-health
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /var/run/gl-wan-online
}
