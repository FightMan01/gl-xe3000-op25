#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

start_service() {
	[ -d /sys/class/leds/green:wan ] || return 0

	# gl-wan-health drives the LED from its own probes whenever it runs;
	# this loop is only the fallback for when it is turned off.
	[ "$(uci -q get gl-wan-health.health.enabled)" != "0" ] &&
		/etc/init.d/gl-wan-health enabled && return 0

	procd_open_instance
	procd_set_param command /usr/sbin/gl-internet-led
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
