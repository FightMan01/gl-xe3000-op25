#!/bin/sh /etc/rc.common
# Re-apply the persisted fan start threshold at boot: the kernel resets the
# thermal trips to the DTS defaults on every boot, so the 60 C level-1 trip
# comes back and the fan would spin up there until this runs.

START=19

start() {
	local temperature
	temperature="$(uci -q get gl-oui-rpc.fan.temperature)"
	[ -n "$temperature" ] || temperature=85
	/usr/sbin/gl-fan-set-threshold "$temperature" 2>/dev/null
}
