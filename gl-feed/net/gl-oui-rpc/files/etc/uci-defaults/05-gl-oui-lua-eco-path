#!/bin/sh
# Older lua-eco builds installed their modules under /usr/local/lib/lua/5.4,
# which the eco interpreter does not search, so every eco daemon died at
# startup with "module .eco.ubus. not found". Current lua-eco and lua-cjson
# install into /usr/lib/lua directly; this only links anything an older
# install left under /usr/local.
mkdir -p /usr/lib/lua/5.4
for f in /usr/local/lib/lua/5.4/*; do
	[ -e "$f" ] || continue
	b="${f##*/}"
	[ -e "/usr/lib/lua/5.4/$b" ] || ln -s "$f" "/usr/lib/lua/5.4/$b"
done
exit 0
