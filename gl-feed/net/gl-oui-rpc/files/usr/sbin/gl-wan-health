#!/bin/sh
#
# gl-wan-health: independent reachability self-heal for the mwan3-managed WAN.
#
# Why this exists
# ---------------
# mwan3's own ping tracker (mwan3track) has long-standing state-machine bugs
# where, after the interface is taken down and back up, or its address
# changes, it can wedge reporting the interface as "online"/"connecting"
# while the link actually carries no traffic. mwan3 then keeps the dead
# interface in the active policy, so nothing fails over and the router looks
# connected (Internet LED on) while passing nothing. It only recovers on
# `mwan3 restart`, and no amount of pinging the tracker's targets brings it
# back. Upstream references this reproduces against (mwan3 2.10-2.12):
#   - openwrt/packages#18087  tracker stuck in "connecting"/"online" after ifdown/ifup
#   - openwrt/packages#18841  interface locked in "online" while actually down
#   - openwrt/packages#20924  down->up leaves mwan3 not detecting missing internet
#   - openwrt/packages#26690  interface does not come back after an address change
#
# This port triggers those races constantly: the cellular watchdog redials
# wwan (ifdown/ifup), the repeater re-associates, and the modem re-registers
# on cell changes. Both uplink types failing the same way is the fingerprint
# of the shared mwan3 layer, not either uplink.
#
# What it does
# ------------
# Instead of trusting mwan3track, this directly verifies real reachability
# through each uplink that is up at the netifd level, and compares that to
# what mwan3 claims. It acts only on a proven contradiction:
#   * mwan3 says an interface is "online" but it has no real reachability
#     (the classic wedged tracker), or
#   * no interface is "online" per mwan3, yet one that is up does have
#     real reachability (mwan3 is wrongly down and not using a working WAN).
# In both cases it rebuilds mwan3 (the documented fix); if mwan3 restarts
# alone don't help, it escalates to a fresh ifdown/ifup of the active
# non-modem uplink. The cellular uplink is left entirely to
# gl-cellular-boot-redial so the two never fight over the same interface.
#
# It deliberately does nothing when there is genuinely no internet through
# any uplink (a real outage - the per-uplink watchdogs own that), and it is
# rate-limited and serialized on /var/run/gl-net-reconfig.lock so the worst
# case is a bounded restart, never a loop.
#
# It also publishes real connectivity to /var/run/gl-wan-online, which
# gl-internet-led uses so the LED stops lying when mwan3 is stuck.

TAG=gl-wan-health
NET_LOCK=/var/run/gl-net-reconfig.lock
STATE_FILE=/var/run/gl-wan-online
CONFIG=gl-wan-health

opt() {
	local val
	val="$(uci -q get $CONFIG.health.$1)"
	echo "${val:-$2}"
}

CHECK_PERIOD=$(opt check_period_sec 15)
FAIL_THRESHOLD=$(opt fail_threshold 4)
RESET_MAX=$(opt reset_max 5)
RESET_WINDOW=$(opt reset_window_sec 1800)
RESET_GRACE=$(opt reset_grace_sec 90)
STARTUP_GRACE=$(opt startup_grace_sec 120)

fail_count=0
reset_count=0
reset_window_start=0
grace_until=$(( $(date +%s) + STARTUP_GRACE ))

log() {
	logger -p "$1" -t "$TAG" "$2"
}

# Every mwan3 interface that is enabled and actually ping-tracked.
mwan3_tracked_ifaces() {
	local ifc
	for ifc in $(uci -q show mwan3 2>/dev/null | sed -n 's/^mwan3\.\([^.]*\)=interface$/\1/p'); do
		[ "$(uci -q get mwan3."$ifc".enabled)" = "0" ] && continue
		[ -z "$(uci -q get mwan3."$ifc".track_ip)" ] && continue
		echo "$ifc"
	done
}

iface_up() {
	[ "$(ubus call network.interface."$1" status 2>/dev/null |
		jsonfilter -e '@.up' 2>/dev/null)" = "true" ]
}

iface_dev() {
	ubus call network.interface."$1" status 2>/dev/null |
		jsonfilter -e '@.l3_device' 2>/dev/null
}

# mwan3's own opinion of an interface: online / offline / connecting / ...
mwan3_state() {
	ubus call mwan3 status 2>/dev/null |
		jsonfilter -e "@.interfaces[\"$1\"].status" 2>/dev/null
}

# Real reachability through a specific egress. ICMP first, then HTTP(S): a
# carrier can deprioritize/drop bare ICMP while HTTP keeps working, and a
# gateway can answer ICMP with destination-unreachable while no real internet
# exists, so require a positive ping *or* a real HTTP fetch.
conn_ok() {
	local dev="$1"
	[ -n "$dev" ] || return 1
	ping -I "$dev" -c 1 -W 2 1.1.1.1 >/dev/null 2>&1 && return 0
	ping -I "$dev" -c 1 -W 2 9.9.9.9 >/dev/null 2>&1 && return 0
	command -v curl >/dev/null 2>&1 || return 1
	curl --interface "$dev" --connect-timeout 3 -m 5 -k -sS -o /dev/null \
		http://www.msftconnecttest.com/connecttest.txt >/dev/null 2>&1 && return 0
	curl --interface "$dev" --connect-timeout 3 -m 5 -k -sS -o /dev/null \
		https://cp.cloudflare.com/generate_204 >/dev/null 2>&1 && return 0
	return 1
}

# The cellular uplink is recovered by gl-cellular-boot-redial (its own
# traffic/AT watchdog); taking it down from here would race that. Every
# other uplink (Ethernet, repeater, tethering) is fair game.
is_modem_iface() {
	case "$1" in
	wwan|wwan_4|modem*) return 0 ;;
	*) return 1 ;;
	esac
}

# Probe every tracked uplink. Sets:
#   online_any  mwan3 reports at least one interface online
#   online_good at least one interface mwan3 says is online really works
#   up_good     at least one interface that is up really works
#   best_iface  a non-modem interface to refresh as a last resort
probe() {
	online_any=0
	online_good=0
	up_good=0
	best_iface=""
	local ifc dev st up ok
	for ifc in $(mwan3_tracked_ifaces); do
		up=0
		iface_up "$ifc" && up=1
		# Only probe interfaces that could plausibly carry traffic.
		[ "$up" = "1" ] || [ "$(mwan3_state "$ifc")" = "online" ] || continue
		dev="$(iface_dev "$ifc")"
		ok=0
		conn_ok "$dev" && ok=1
		st="$(mwan3_state "$ifc")"
		[ "$st" = "online" ] && online_any=1
		[ "$st" = "online" ] && [ "$ok" = "1" ] && online_good=1
		[ "$up" = "1" ] && [ "$ok" = "1" ] && up_good=1
		[ "$up" = "1" ] && [ -z "$best_iface" ] && ! is_modem_iface "$ifc" && best_iface="$ifc"
	done
}

# Rebuild mwan3's state; escalate to a fresh DHCP/association on the active
# non-modem uplink if restarts alone don't help. Serialized on the shared
# reconfig lock so it can never interleave with the cellular/repeater paths.
recover() {
	local now
	now="$(date +%s)"
	if [ $((now - reset_window_start)) -gt "$RESET_WINDOW" ]; then
		reset_window_start=$now
		reset_count=0
	fi
	reset_count=$((reset_count + 1))
	if [ "$reset_count" -gt "$RESET_MAX" ]; then
		log daemon.err "$reset_count recoveries in ${RESET_WINDOW}s without restoring connectivity; backing off"
		return 1
	fi

	if [ "$reset_count" -ge 3 ] && [ -n "$best_iface" ]; then
		log daemon.warning \
			"mwan3 still inconsistent; refreshing uplink $best_iface (ifdown/ifup) (attempt $reset_count/$RESET_MAX)"
		(
			tries=0
			until flock -n 9; do
				tries=$((tries + 1)); [ "$tries" -ge 30 ] && exit 1; sleep 1
			done
			ifdown "$best_iface" >/dev/null 2>&1
			sleep 2
			ifup "$best_iface" >/dev/null 2>&1
			sleep 2
			/etc/init.d/mwan3 restart >/dev/null 2>&1
		) 9>"$NET_LOCK"
	else
		log daemon.warning \
			"mwan3 state contradicts real reachability; resetting mwan3 (attempt $reset_count/$RESET_MAX)"
		(
			tries=0
			until flock -n 9; do
				tries=$((tries + 1)); [ "$tries" -ge 30 ] && exit 1; sleep 1
			done
			/etc/init.d/mwan3 restart >/dev/null 2>&1
		) 9>"$NET_LOCK"
	fi
	grace_until=$(( $(date +%s) + RESET_GRACE ))
	return 0
}

echo 0 > "$STATE_FILE"

while :; do
	probe

	# Healthy: mwan3 reports an interface online and it really has internet.
	if [ "$online_good" = "1" ]; then
		fail_count=0
		echo 1 > "$STATE_FILE"
		sleep "$CHECK_PERIOD"
		continue
	fi
	echo 0 > "$STATE_FILE"

	# Is this mwan3 contradicting reality, or a genuine outage?
	#   online_any && !online_good : mwan3 claims connected, nothing works
	#   !online_any && up_good     : a working uplink exists but mwan3 uses none
	contradiction=0
	[ "$online_any" = "1" ] && [ "$online_good" = "0" ] && contradiction=1
	[ "$online_any" = "0" ] && [ "$up_good" = "1" ] && contradiction=1

	if [ "$contradiction" = "0" ]; then
		# No internet through any uplink at all - a real outage. The
		# per-uplink watchdogs (cellular redial, repeater re-associate) own
		# this; restarting mwan3 would only add churn.
		fail_count=0
		log daemon.notice \
			"no internet through any uplink; leaving recovery to the per-uplink watchdogs"
		sleep "$CHECK_PERIOD"
		continue
	fi

	now="$(date +%s)"
	if [ "$now" -lt "$grace_until" ]; then
		sleep "$CHECK_PERIOD"
		continue
	fi

	fail_count=$((fail_count + 1))
	if [ "$fail_count" -lt "$FAIL_THRESHOLD" ]; then
		sleep "$CHECK_PERIOD"
		continue
	fi
	fail_count=0

	if [ "$online_any" = "1" ]; then
		log daemon.warning \
			"mwan3 reports an interface online with no real reachability (wedged tracker)"
	else
		log daemon.warning \
			"an uplink has real reachability but mwan3 reports nothing online"
	fi
	recover

	sleep "$CHECK_PERIOD"
done
