#!/bin/sh /etc/rc.common

START=99
STOP=10

PROC=/proc/net/wifidog-ng/config

create_ipsets() {
	# The kernel module treats these two sets as the allow-list.  Empty sets
	# intentionally mean "redirect/drop unknown clients".
	ipset -! create wifidog-ng-mac hash:mac timeout 4294967 2>/dev/null
	ipset -! create wifidog-ng-ip hash:ip 2>/dev/null
}

write_config() {
	[ -e "$PROC" ] || return 1
	printf '%s\n' \
		'interface=br-lan' \
		'port=80' \
		'ssl_port=443' \
		'enabled=0' > "$PROC"
}

start() {
	# wifidog-ng is an optional KernelPackage (intentionally not a hard
	# dependency).  Without it the gate simply stays disabled and the
	# repeater portal flow still works through the STA uplink, so a missing
	# module is a valid configuration, not a service failure - don't make
	# rcS log an error (and don't create the sets the module would own).
	if ! modprobe wifidog-ng 2>/dev/null; then
		logger -t gl-portal "wifidog-ng not available; captive gate stays disabled"
		return 0
	fi
	create_ipsets
	# Keep the module loaded but fail-safe disabled.  Enabling an empty
	# wifidog allow-list would block ordinary LAN traffic; the repeater portal
	# flow does not need interception because the UI calls enter_bare_mode
	# before opening the upstream URL.
	write_config
}

stop() {
	[ -e "$PROC" ] && printf 'enabled=0\n' > "$PROC"
	modprobe -r wifidog-ng 2>/dev/null || true
}
