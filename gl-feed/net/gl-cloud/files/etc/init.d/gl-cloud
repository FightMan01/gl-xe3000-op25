#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service() {
	[ "$(uci -q get gl-cloud.@cloud[0].enable)" = "1" ] || return 0

	mkdir -p /var/run/cloud

	procd_open_instance
	procd_set_param command /usr/bin/eco /usr/bin/gl-cloud
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Remote access must not outlive the cloud session it was opened for.
	ubus call service delete '{"name":"rtty"}' >/dev/null 2>&1
	rm -f /var/run/rtty /var/run/cloud/ca.crt
}

reload_service() {
	stop
	start
}
