#!/bin/sh /etc/rc.common

START=15
STOP=10

USE_PROCD=1

start_service() {
	# Devices with a status screen keep the monitor running even while the
	# page toggle is off (the screen shows the score). On the XE3000 there
	# is no screen, so the feature only runs when the user enabled it.
	if [ ! -e /proc/gl-hw-info/screen ]; then
		enabled="$(uci -q get network-quality.global.enabled 2>/dev/null)"
		[ "$enabled" = "1" ] || return 0
	fi

	procd_open_instance
	procd_set_param command /usr/bin/eco /usr/sbin/network-quality
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
