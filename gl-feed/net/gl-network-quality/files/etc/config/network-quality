config global 'global'
	option enabled '0'
	option log 'INFO'
	option ethernet_ping_address 'google.com'
	option dns_probe_domain 'google.com'
	option ping_interval '1'
	option dns_interval '1'
	option dns_timeout '1'
	option ping_timeout '1'
	option speedtest_download_bytes '1073741824'
	option speedtest_download_interval '1'
	option speedtest_download_concurrency '4'
	option speedtest_upload_bytes '1073741824'
	option speedtest_upload_interval '1'
	option speedtest_upload_concurrency '4'
	list preset_target 'Baidu=baidu.com'
	list preset_target 'Tencent=qq.com'
	list preset_target 'Alibaba=www.aliyun.com'
	list preset_target 'Google=google.com'
	list preset_target 'Microsoft=www.microsoft.com'
	list preset_target 'Cloudflare=cloudflare.com'
