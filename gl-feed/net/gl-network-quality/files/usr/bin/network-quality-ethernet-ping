#!/bin/sh
# One ICMP echo to the configured internet reachability target.
# Prints: "<status> <latency-ms> [resolved-ip]"

target="$1"
ping_timeout="$2"

[ -n "$target" ] || exit 1
[ -n "$ping_timeout" ] || ping_timeout=1

output=$(ping -c1 -W"$ping_timeout" "$target" 2>&1)
rc=$?

if [ "$rc" -eq 0 ]; then
	latency=$(echo "$output" | sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p' | head -n1)
	resolved_ip=$(echo "$output" | sed -n 's/^PING .* (\([^)]*\)).*/\1/p' | head -n1)
	[ -n "$latency" ] && {
		echo "0 $latency ${resolved_ip:-}"
		exit 0
	}
fi

reason=$(printf '%s' "$output" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')
echo "1 -1 $reason"
exit 1
