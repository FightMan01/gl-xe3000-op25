#!/bin/sh
# Passive modem tracer. Keeps a RAM ring of read-only AT snapshots and writes
# it to /root/relock-traces when the SIM falls back to PIN-locked or the PS
# attach drops, so the seconds before such an event survive a reboot.
# Opt-in: started only with gl-cellular.watchdog.relock_trace=1.

RING=/tmp/relock-trace.log
OUT=/root/relock-traces
# 10s keeps three samples inside TAIL_SEC and halves the AT traffic of 5s.
INTERVAL=10
# A full sample is eight serialized AT round-trips on the one AT port, and the
# moment that port matters most is the moment it has stopped answering: each
# command then costs its own full timeout and pushes every other caller - the
# watchdog's AT+CPIN?, the PIN entry itself - further down the queue. So while
# the modem is unhealthy the sample is cut down to the three reads that say
# whether the card and the bearer are alive at all (CPIN, attach, and the card
# identity/ATR), at the normal interval, and the four cosmetic reads are skipped.
# They answer nothing useful in that state anyway - during a card
# re-initialisation QENG returns SEARCH and QCAINFO returns a bare OK.
RING_LINES=1500
TAIL_SEC=30
MAX_DUMPS=6
COOLDOWN=180

at() {
	ubus -t 6 call cellular.at command "{\"cmd\":\"$1\",\"timeout\":4}" 2>/dev/null |
		jsonfilter -e '@.response' 2>/dev/null | tr '\r\n' '  ' | sed 's/  */ /g'
}

dump() {
	local f
	mkdir -p "$OUT"
	f="$OUT/trace-$(date +%Y%m%d-%H%M%S)-$1.log"
	{
		echo "# reason=$1 uptime=$(cut -d' ' -f1 /proc/uptime)"
		cat "$RING"
		echo "# ---- logread"
		logread | tail -400
		echo "# ---- mcu"
		ubus -t 3 call mcu status 2>/dev/null
		echo "# ---- dmesg"
		dmesg | tail -80
	} > "$f"
	ls -t "$OUT"/trace-*.log 2>/dev/null | tail -n +$((MAX_DUMPS + 1)) | xargs rm -f 2>/dev/null
}

prev_pin=0
prev_att=""
dump_at=0
dump_reason=""
last_dump=0
unhealthy=0
n=0

while :; do
	now=$(date +%s)
	cpin=$(at 'AT+CPIN?')
	att=$(at 'AT+CGATT?' | grep -oE 'CGATT: [01]' | tail -n1)
	line="$(date +%H:%M:%S) cpin=[$cpin] att=[$att]"
	# The card itself, not just the modem's opinion of it. QSIMCFG's
	# dual_slot_status returns the slot state, the card's ATR and its ICCID in
	# a single read, so samples either side of a re-initialisation say whether
	# the card is the same one and came back with the same electrical
	# characteristics - an ATR whose TA2 byte changed would be a voltage-class
	# switch, a different fault entirely. It is also the cheapest way to tell
	# "the card is gone" apart from "the modem lost track of it": a missing
	# card drops the ICCID out of the reply instead of the whole command
	# hanging the way AT+CPIN? does.
	card=$(at 'AT+QSIMCFG=\"dual_slot_status\"')
	line="$line card=[$card]"
	case "$cpin" in *"+CPIN: READY"*) ;; *) unhealthy=1 ;; esac
	printf '%s' "$card" | grep -qE '[0-9A-Fa-f]{30,}' || unhealthy=1
	if [ "$unhealthy" -eq 0 ]; then
		line="$line eng=[$(at 'AT+QENG=\"servingcell\"')]"
		line="$line ca=[$(at 'AT+QCAINFO')]"
		line="$line c5=[$(at 'AT+C5GREG?')] ce=[$(at 'AT+CEREG?')]"
	else
		line="$line eng=[skipped] ca=[skipped] c5=[skipped] ce=[skipped]"
	fi
	# Battery vs. charger: relocks are only seen on the move.
	# Fields: charging_status charge_percent temperature.
	line="$line bat=[$(ubus -t 3 call mcu status 2>/dev/null |
		jsonfilter -e '@.charging_status' -e '@.charge_percent' -e '@.temperature' 2>/dev/null |
		tr '\n' ' ')]"
	if [ $((n % 6)) -eq 0 ] && [ "$unhealthy" -eq 0 ]; then
		line="$line temp=[$(at 'AT+QTEMP' | grep -oE '\"(mdmss-0-usr|modem-lte-sub6-pa1)\",\"[0-9-]+\"' | tr '\n' ' ')]"
	fi
	echo "$line" >> "$RING"
	n=$((n + 1))
	if [ $((n % 100)) -eq 0 ]; then
		tail -n "$RING_LINES" "$RING" > "$RING.new" && mv "$RING.new" "$RING"
	fi

	pin=0
	case "$cpin" in *"SIM PIN"*) pin=1 ;; esac
	if [ "$dump_at" -eq 0 ] && [ $((now - last_dump)) -ge "$COOLDOWN" ]; then
		if [ "$pin" -eq 1 ] && [ "$prev_pin" -eq 0 ]; then
			dump_at=$((now + TAIL_SEC)); dump_reason=simpin
		elif [ "$att" = "CGATT: 0" ] && [ "$prev_att" = "CGATT: 1" ]; then
			dump_at=$((now + TAIL_SEC)); dump_reason=detach
		fi
	fi
	prev_pin=$pin
	[ -n "$att" ] && prev_att=$att

	# Dump before sleeping, so a bad sample never delays the capture of the
	# episode that triggered it.
	if [ "$dump_at" -ne 0 ] && [ "$now" -ge "$dump_at" ]; then
		dump "$dump_reason"
		last_dump=$now
		dump_at=0
	fi
	unhealthy=0
	sleep "$INTERVAL"
done
