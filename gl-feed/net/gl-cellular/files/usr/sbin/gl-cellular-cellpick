#!/bin/sh
# Opt-in passive LTE cell picker: gl-cellular.cellpick.enabled=1.
#
# On a crowded train the strongest cell is often the one everybody is on.
# This watches the serving cell's quality (RSRQ/SINR drop when a cell is
# loaded) and, only when it has been clearly bad for a while and a neighbour
# is clearly better, locks that neighbour once. There are no speed tests or
# trial locks, so a switch costs a single short reconnect.
#
# - 5G first: while an NR carrier is attached nothing is touched.
# - It reads the same cached cell_info the web UI uses, one query per
#   poll_sec; the neighbour list is read only when the cell is already bad.
# - A held lock is released when the cell degrades, vanishes, or 5G shows
#   up with a bad LTE cell; it is never released on a timer.
#
# UCI gl-cellular.cellpick: enabled, poll_sec (30), bad_polls (3),
# bad_rsrq (-14), bad_sinr (3), gain_rsrq (4), min_rsrp (-105),
# max_rsrp_loss (12), dwell_sec (300).

CFG=gl-cellular.cellpick
HELD=0          # uptime when we locked a cell, 0 = no lock held
BAD=0
NOREAD=0
LAST_SWITCH=0

opt() { uci -q get "$CFG.$1" || echo "$2"; }
log() { logger -t gl-cellpick "$*"; }
now() { cut -d. -f1 /proc/uptime; }

at() {
	local c
	c=$(printf '%s' "$1" | sed 's/"/\\"/g')
	ubus -t 15 call cellular.at command "{\"cmd\":\"$c\",\"timeout\":${2:-10}}" 2>/dev/null |
		jsonfilter -e '@.response' 2>/dev/null
}

# A user-set tower or operator lock always wins.
user_locked() {
	[ -n "$(uci -q get gl-cellular.tower_slot1)" ] && return 0
	[ "$(uci -q get gl-cellular.state.operator_mode)" = "1" ] && return 0
	return 1
}

unlock() {
	at 'AT+QNWLOCK="common/4g",0' >/dev/null
	uci -q set $CFG.owned=0; uci commit gl-cellular
	HELD=0
}

lock_lte() {
	uci -q set $CFG.owned=1; uci commit gl-cellular
	at "AT+QNWLOCK=\"common/4g\",1,$1,$2" >/dev/null
	/usr/sbin/gl-cellular-wwan-reconnect >/dev/null 2>&1
	HELD=$(now); LAST_SWITCH=$HELD; BAD=0
}

# A lock left over from before a crash or reboot is ours to clear.
[ "$(uci -q get $CFG.owned)" = "1" ] && unlock

while :; do
	sleep "$(opt poll_sec 30)"
	if [ "$(opt enabled 0)" != "1" ]; then [ "$HELD" != 0 ] && unlock; continue; fi
	user_locked && continue

	info=$(ubus -t 8 call cellular cell_info 2>/dev/null) || continue
	rsrp=$(echo "$info" | jsonfilter -e '@.signal[0].rsrp')
	rsrq=$(echo "$info" | jsonfilter -e '@.signal[0].rsrq')
	sinr=$(echo "$info" | jsonfilter -e '@.signal[0].sinr')
	earfcn=$(echo "$info" | jsonfilter -e '@.signal[0].earfcn')
	pci=$(echo "$info" | jsonfilter -e '@.signal[0].pci')
	nr=$(echo "$info" | jsonfilter -e '@.signal[*].network_type' | grep -c '^5$')

	# No reading (modem re-registering, SIM relock, ...): leave everything alone.
	# A held lock whose cell has vanished (train moved on) is let go.
	if [ -z "$rsrp" ] || [ -z "$rsrq" ]; then
		BAD=0; NOREAD=$((NOREAD + 1))
		if [ "$HELD" != 0 ] && [ "$NOREAD" -ge 3 ]; then
			log "locked cell lost, back to automatic"
			unlock; /usr/sbin/gl-cellular-wwan-reconnect >/dev/null 2>&1
		fi
		continue
	fi
	NOREAD=0

	bad=0
	[ "$rsrq" -le "$(opt bad_rsrq -14)" ] && bad=1
	[ -n "$sinr" ] && [ "$sinr" -le "$(opt bad_sinr 3)" ] && bad=1
	# 5G is attached and carries the traffic: only a bad LTE anchor matters
	# and then only if it is really poor.
	[ "$nr" -gt 0 ] && [ "$bad" = 1 ] && [ "$rsrq" -gt -18 ] && bad=0

	if [ "$bad" = 0 ]; then BAD=0; continue; fi
	BAD=$((BAD + 1))
	[ "$BAD" -ge "$(opt bad_polls 3)" ] || continue
	t=$(now)
	[ "$LAST_SWITCH" != 0 ] && [ $((t - LAST_SWITCH)) -lt "$(opt dwell_sec 300)" ] && continue

	# Pick the neighbour with the best RSRQ, as long as it is not much weaker.
	best=$(at 'AT+QENG="neighbourcell"' | tr -d '"' |
		awk -F, -v e="$earfcn" -v p="$pci" -v cq="$rsrq" -v cp="$rsrp" \
			-v gain="$(opt gain_rsrq 4)" -v minp="$(opt min_rsrp -105)" -v loss="$(opt max_rsrp_loss 12)" '
		/neighbourcell/ && $2 == "LTE" && !($3 == e && $4 == p) {
			q = $5 + 0; r = $6 + 0
			if (r >= minp && r >= cp - loss && q >= cq + gain && (best == "" || q > bq)) { best = $3 " " $4; bq = q }
		} END { print best }')

	if [ -n "$best" ]; then
		set -- $best
		log "serving $earfcn/$pci rsrq $rsrq sinr $sinr rsrp $rsrp -> locking $1/$2"
		lock_lte "$1" "$2"
	elif [ "$HELD" != 0 ]; then
		log "held cell degraded and nothing better, back to automatic"
		unlock
		/usr/sbin/gl-cellular-wwan-reconnect >/dev/null 2>&1
		LAST_SWITCH=$t; BAD=0
	else
		BAD=0   # nothing better exists; keep looking at the normal rate
	fi
done
