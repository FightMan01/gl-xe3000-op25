#!/bin/sh
# qcm and the watchdog share this gate before starting a data call.
# Exit: 0 ready, 1 missing/mismatched PIN binding, 2 unsafe PIN retry,
# 3 absent/PUK SIM, 4 unavailable AT, 5 unlock busy or outcome unknown.

TAG=gl-cellular-sim

# Not while upgrade_cellular flashes the modem; 5 = busy, retried later.
[ -e /var/run/gl-cellular-flashing ] && exit 5
. /usr/share/libubox/jshn.sh

at() {
	json_init
	json_add_string cmd "$1"
	json_add_int timeout "${2:-5}"
	ubus -t $(( ${2:-5} + 3 )) call cellular.at command "$(json_dump)" 2>/dev/null |
		jsonfilter -e '@.response' 2>/dev/null
}

cpin_state() {
	local r
	r=$(at 'AT+CPIN?' 4)
	case "$r" in
		*"+CPIN: READY"*) echo READY ;;
		*"+CPIN: SIM PIN"*) echo PIN ;;
		*"+CPIN: SIM PUK"*) echo PUK ;;
		"") echo NOAT ;;
		*) echo OTHER ;;
	esac
}

# pin_pending holds the SIM's PIN attempt counter from just before our last
# AT+CPIN=, until READY confirms it.
clear_pending() {
	[ -n "$(uci -q get network.wwan.pin_pending)" ] || return 0
	uci -q delete network.wwan.pin_pending && uci -q commit network
}

exec 8>/var/run/gl-cellular-sim-unlock.lock || exit 5
i=0
until flock -n 8; do
	i=$((i + 1))
	[ "$i" -ge 40 ] && exit 5
	sleep 1
done

# AT starts after netifd at boot.
state=NOAT
i=0
while [ "$i" -lt 60 ]; do
	state=$(cpin_state)
	[ "$state" != NOAT ] && [ "$state" != OTHER ] && break
	i=$((i + 1))
	sleep 2
done

case "$state" in
	READY) clear_pending || exit 5; exit 0 ;;
	PUK) logger -p daemon.err -t "$TAG" "SIM is PUK-locked"; exit 3 ;;
	NOAT) logger -p daemon.err -t "$TAG" "modem AT interface unavailable"; exit 4 ;;
	OTHER) logger -p daemon.err -t "$TAG" "SIM absent or not ready"; exit 3 ;;
esac

pin=$(uci -q get network.wwan.pincode)
saved_iccid=$(uci -q get network.wwan.pin_iccid)
case "$pin" in
	""|*[!0-9]*) exit 1 ;;
esac
[ "${#pin}" -ge 4 ] && [ "${#pin}" -le 8 ] || exit 1
if [ "$(uci -q get network.wwan.pin_failed)" = 1 ]; then
	logger -p daemon.warn -t "$TAG" "saved PIN was rejected before; waiting for PIN entry in the UI"
	exit 2
fi

cur_iccid=$(at 'AT+QCCID' 4 | tr -d '\r' | sed -n 's/^+QCCID:[[:space:]]*\([0-9A-Za-z]*\)[[:space:]]*$/\1/p' | head -n1)
[ -n "$cur_iccid" ] || exit 4
if [ -z "$saved_iccid" ] || [ "$saved_iccid" != "$cur_iccid" ]; then
	logger -p daemon.warn -t "$TAG" "no saved PIN binding for the current SIM; waiting for PIN entry in the UI"
	exit 1
fi

left=$(at 'AT+QPINC?' 4 | tr -d '\r' | sed -n 's/^+QPINC:[[:space:]]*"SC",\([0-9][0-9]*\),[0-9][0-9]*[[:space:]]*$/\1/p' | head -n1)
case "$left" in
	"") logger -p daemon.warn -t "$TAG" "PIN attempt counter unavailable"; exit 4 ;;
	0|1) logger -p daemon.err -t "$TAG" "too few PIN attempts left; refusing automatic PIN entry"; exit 2 ;;
	2|3) ;;
	*) logger -p daemon.warn -t "$TAG" "invalid PIN attempt counter"; exit 4 ;;
esac

# An earlier submission never confirmed READY (its reply can be lost while
# the modem resets the card). The counter tells what happened: lower means
# the SIM refused that PIN; unchanged means it never reached the card, or it
# was accepted and the card has been reset since. Never block on it for good,
# or a re-lock in a tunnel leaves the router offline until the UI is used.
pending=$(uci -q get network.wwan.pin_pending)
if [ -n "$pending" ]; then
	case "$pending" in *[!0-9]*) pending=0 ;; esac
	if [ "$left" -lt "$pending" ]; then
		uci -q set network.wwan.pin_failed=1
		uci -q delete network.wwan.pin_pending
		uci -q commit network
		logger -p daemon.err -t "$TAG" "an earlier PIN submission was rejected (attempts $pending -> $left); waiting for PIN entry in the UI"
		exit 2
	fi
	logger -t "$TAG" "earlier PIN submission unconfirmed but no attempt was used ($left left); entering it again"
fi

# Recheck user intent after the AT queries and lock wait.
[ "$(uci -q get network.wwan.auto)" != 0 ] || exit 5
[ "$(uci -q get network.wwan.disabled)" != 1 ] || exit 5
[ "$(uci -q get gl-cellular.state.dial_enabled)" != 0 ] || exit 5
[ "$(uci -q get gl-cellular.state.scan_in_progress)" != 1 ] || exit 5

# Persist before submission: a killed caller must not leave another free retry.
uci -q set network.wwan.pin_pending="$left" && uci -q commit network || exit 5
logger -t "$TAG" "SIM is PIN-locked; entering the saved PIN"
resp=$(at "AT+CPIN=\"$pin\"" 10 | tr -d '\r')
if printf '%s\n' "$resp" | grep -qE '^\+CME ERROR:[[:space:]]*(16|incorrect password)[[:space:]]*$'; then
	uci -q set network.wwan.pin_failed=1
	uci -q commit network
	logger -p daemon.err -t "$TAG" "saved PIN was rejected by the SIM"
	exit 2
fi

# READY reconciles a lost final reply without resubmitting the PIN.
i=0
while [ "$i" -lt 20 ]; do
	state=$(cpin_state)
	if [ "$state" = READY ]; then
		clear_pending || exit 5
		sleep 4
		logger -t "$TAG" "SIM unlocked"
		exit 0
	fi
	[ "$state" = PUK ] && exit 3
	i=$((i + 1))
	sleep 1
done
logger -p daemon.warn -t "$TAG" "PIN submission not confirmed READY; the attempt counter decides on the next try"
exit 5
