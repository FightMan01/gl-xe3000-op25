#!/bin/sh

TAG=gl-cellular-wwan-watchdog
failures=0

enabled() {
	[ "$(uci -q get network.wwan.auto)" != "0" ] || return 1
	[ "$(uci -q get network.wwan.disabled)" != "1" ] || return 1
	[ "$(uci -q get gl-cellular.state.dial_enabled)" != "0" ]
}

traffic_ok() {
	local device up target
	device="$(ifstatus wwan_4 2>/dev/null |
		jsonfilter -e '@.l3_device' 2>/dev/null)"
	up="$(ifstatus wwan_4 2>/dev/null |
		jsonfilter -e '@.up' 2>/dev/null)"
	[ "$up" = "true" ] && [ -n "$device" ] || return 2

	for target in 1.1.1.1 8.8.8.8; do
		ping -I "$device" -c 1 -W 2 "$target" >/dev/null 2>&1 && return 0
	done
	return 1
}

sleep 25
while :; do
	if ! enabled; then
		failures=0
		sleep 30
		continue
	fi

	traffic_ok
	status=$?
	case "$status" in
	0)
		failures=0
		;;
	1)
		failures=$((failures + 1))
		if [ "$failures" -ge 3 ]; then
			logger -p daemon.warning -t "$TAG" \
				"cellular interface has no traffic; performing recovery redial"
			ifdown wwan >/dev/null 2>&1
			sleep 4
			if enabled; then ifup wwan >/dev/null 2>&1; fi
			failures=0
		fi
		;;
	*)
		failures=0
		;;
	esac

	sleep 30
done
