#!/bin/sh
#
# Pick the right netifd proto for whichever PCIe/MHI modem is fitted.
#
# 90-gl-cellular-wwan seeds network.wwan as proto=mbim,
# device=/dev/wwan0mbim0 - correct for the Quectel RM520N-GL, whose MHI
# firmware personality exposes an IP_HW0_MBIM control channel there.
#
# The Quectel RM551E-GL (Qualcomm SDX75) doesn't implement that MBIM
# personality; mainline's generic Qualcomm MHI channel layout gives it
# a QMI control channel instead, which the kernel exposes as
# /dev/wwan0qmi0 rather than /dev/wwan0mbim0 (both nodes come from
# kmod-mhi-wwan-ctrl/kmod-mhi-net, already gl-cellular dependencies -
# no extra kernel module is needed for either modem).
#
# This waits once, at boot, for whichever control port actually shows
# up and switches network.wwan to match if it isn't already - a no-op
# on the RM520N-GL, since wwan0mbim0 matches the static default above.

TAG=gl-cellular-wwan-autoproto

[ "$(uci -q get network.wwan)" = "interface" ] || exit 0

port=""
i=0
while [ "$i" -lt 30 ]; do
	if [ -c /dev/wwan0mbim0 ]; then
		port=mbim
		break
	fi
	if [ -c /dev/wwan0qmi0 ]; then
		port=qmi
		break
	fi
	i=$((i + 1))
	sleep 1
done

[ -n "$port" ] || {
	logger -p daemon.warning -t "$TAG" \
		"no wwan0mbim0 or wwan0qmi0 control port appeared after 30s"
	exit 0
}

want_device="/dev/wwan0${port}0"
[ "$(uci -q get network.wwan.proto)" = "$port" ] &&
	[ "$(uci -q get network.wwan.device)" = "$want_device" ] && exit 0

logger -p daemon.notice -t "$TAG" \
	"switching network.wwan to proto=$port device=$want_device"

uci -q batch <<-EOF
	set network.wwan.proto='$port'
	set network.wwan.device='$want_device'
EOF
uci -q commit network

ifup wwan >/dev/null 2>&1

exit 0
