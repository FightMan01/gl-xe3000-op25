#!/bin/sh
#
# gl-cellular-rat: choose which radio technologies the modem is allowed to
# camp on, and hold that choice across the dial that follows.
#
# Why this exists
# ---------------
# Under NSA the modem registers LTE first and adds a 5G secondary node on top
# (Quectel's own "5G Network Searching Scheme" doc: "In NSA network
# registration, LTE is registered first, and then 5G cell is added"). A handset
# and an RM520N-GL sitting on the same eNB can therefore end up with materially
# different radio behaviour, and in a congested cell - a train full of people -
# the NR leg is the fragile one. When the secondary node drops, the whole
# bearer goes with it. Forcing LTE-only trades peak throughput for a bearer
# that does not get torn down underneath you, which is the right trade for a
# backup uplink and the wrong one for a primary.
#
# So this does not pick for you: it makes the choice explicit, sticky and
# reversible, and it can fall back to LTE on its own when the data path keeps
# failing (see the watchdog's mhi/nr backoff), then put itself back.
#
# Commands
#   apply            reconcile the modem with the configured preference. Called
#                    from the qcm proto before every dial, so a policy change
#                    takes effect on the next dial rather than the next reboot.
#   show             print the effective preference and the modem's answer.
#   restore          drop any fallback and go back to the configured
#                    preference. Used by the watchdog once the link has been
#                    stable again.
#
# Configuration (gl-cellular.rat)
#   mode_pref  AUTO | LTE | LTE:NR5G | NR5G | WCDMA
#       The standing preference. AUTO means "let the modem decide", which is
#       what it does out of the box. Default: AUTO.
#       Maps straight onto AT+QNWPREFCFG="mode_pref", and this is the exact
#       command sequence GL's own stock cellular manager uses in
#       lib/functions/modem.sh's set_5G_mode()/set_5G_mode_mask()/
#       set_network_mode() - so there is no guesswork about which token is
#       accepted or in what order.
#   fallback_pref
#       What the watchdog falls back to. Default: LTE.
#   The fallback itself is switched and timed by gl-cellular.watchdog's
#   lte_fallback, lte_fallback_after and lte_fallback_hold_sec.
#
# The fallback lives only in tmpfs. After a power loss mid-fallback the first
# dial's `apply` finds no state file and writes the configured preference
# back, so the modem's NVM never stays LTE-only across a reboot.
#
# Note on AT+QNWPREFCFG="rat_acq_order",LTE:NR5G:WCDMA
#   That is the more surgical knob - it keeps 5G available but stops the modem
#   camping on NR first when LTE would serve - and it is what a phone does.
#   It is deliberately NOT used here: the manual says it only takes effect
#   after the module reboots and that it is written to NVM, so every change
#   would cost a full modem re-registration. mode_pref is a live preference.
#   If you want the acq-order behaviour and can live with the re-registration,
#   set it once by hand:
#       AT+QNWPREFCFG="rat_acq_order",LTE:NR5G:WCDMA
#       AT+CFUN=0 / AT+CFUN=1

TAG=gl-cellular-rat
STATE=/var/run/gl-cellular-rat.state
# Band guard (see cmd_band_guard): tmpfs marks "guard active this boot" and
# when it started; the list to restore lives in UCI so it survives a reboot.
GUARD=/var/run/gl-cellular-band-guard

opt() {
	local val
	val="$(uci -q get gl-cellular.rat.$1)"
	echo "${val:-$2}"
}

at() {
	# Escape the quotes every mode_pref command carries; unescaped they make
	# the JSON invalid and ubus drops the command without reaching the modem.
	local cmd
	cmd="$(printf '%s' "$1" | sed 's/"/\\"/g')"
	ubus -t 8 call cellular.at command \
		"{\"cmd\":\"$cmd\",\"timeout\":6}" 2>/dev/null |
		jsonfilter -e '@.response' 2>/dev/null
}

# Validate before sending: mode_pref rejects an unknown token, and writing NVM
# with a typo is not something to discover from a modem that will not camp.
valid_pref() {
	case "$1" in
	AUTO|LTE|LTE:NR5G|NR5G|WCDMA) return 0 ;;
	*) return 1 ;;
	esac
}

set_pref() {
	local want="$1" have

	valid_pref "$want" || {
		logger -p daemon.err -t "$TAG" \
			"refusing unknown mode_pref '$want' (want AUTO, LTE, LTE:NR5G, NR5G or WCDMA)"
		return 1
	}

	have="$(current_pref)"
	[ "$have" = "$want" ] && return 0

	case "$(at "AT+QNWPREFCFG=\"mode_pref\",$want")" in
	*OK*)
		# nr5g_disable_mode is a separate NVM setting GL keeps in step
		# with mode_pref. Leaving it behind a mode_pref change is how you
		# end up asking for NR5G while the modem still has NR disabled,
		# which presents as "modem claims NR5G but only ever camps on
		# LTE". Pair them the same way stock's set_5G_mode() does: 0 when
		# NR is permitted, 1 when only NSA is, 2 when only SA is.
		case "$want" in
		AUTO|NR5G) at 'AT+QNWPREFCFG="nr5g_disable_mode",0' >/dev/null ;;
		LTE:NR5G)  at 'AT+QNWPREFCFG="nr5g_disable_mode",1' >/dev/null ;;
		esac
		logger -p daemon.notice -t "$TAG" \
			"mode_pref ${have:-unknown} -> $want"
		return 0
		;;
	*)
		logger -p daemon.err -t "$TAG" \
			"modem rejected mode_pref $want (it reports '${have:-unknown}')"
		return 1
		;;
	esac
}

configured_pref() {
	opt mode_pref AUTO
}

current_pref() {
	at 'AT+QNWPREFCFG="mode_pref"' | tr -d '\r' |
		sed -n 's/.*"mode_pref",\([^)]*\).*/\1/p' | head -n1
}

# Read the fallback the watchdog may have left behind. Kept in a file rather
# than in UCI so it never becomes the user's standing configuration by
# accident, and so the restore path is a single rm.
fallback_pref() {
	[ -f "$STATE" ] && cat "$STATE" 2>/dev/null
}

cmd_apply() {
	local fb
	# A guard left over from before a reboot has no tmpfs mark: put the
	# bands back before dialling, the same way a stale RAT fallback is.
	if [ ! -f "$GUARD" ] && [ -n "$(uci -q get gl-cellular.state.nsa_band_saved)" ]; then
		cmd_band_guard off
	fi
	fb="$(fallback_pref)"
	if [ -n "$fb" ]; then
		set_pref "$fb" && return 0
	fi
	set_pref "$(configured_pref)"
}

cmd_restore() {
	[ -f "$STATE" ] || return 0
	rm -f "$STATE"
	set_pref "$(configured_pref)"
}

# Enter the LTE fallback. Called by the watchdog when the data path has failed
# repeatedly on a mode that includes 5G.
cmd_fallback() {
	local want
	want="$(opt fallback_pref LTE)"
	valid_pref "$want" || want=LTE
	[ "$(current_pref)" = "$want" ] && return 0
	echo "$want" > "$STATE" 2>/dev/null
	logger -p daemon.notice -t "$TAG" \
		"falling back to mode_pref $want for $(uci -q get gl-cellular.watchdog.lte_fallback_hold_sec || echo 900)s after repeated data-path failures"
	set_pref "$want"
}


# --- band guard --------------------------------------------------------
# Field logs 2026-10-16: the modem's SIM re-locked (and its data plane died)
# twice on one train journey, both times while it was on 5G NSA with the NR
# carrier on n78; the same SIM and route on n1 NSA ran the whole trip. After
# such a re-lock the watchdog calls `band-guard on`, which removes the bands in
# gl-cellular.watchdog.relock_avoid_nr_bands (default 78) from the NSA NR band
# list for a hold window, and `band-guard release` puts the list back once the
# link has been good for that long. Everything else (LTE, other NR bands) is
# untouched. Set relock_avoid_nr_bands to an empty string to disable.
guard_avoid() {
	local val
	val="$(uci -q get gl-cellular.watchdog.relock_avoid_nr_bands)"
	# An option that was set to '' is deleted by uci, so "off" is spelled
	# 'none'; an absent option means the default.
	[ -n "$val" ] || val=78
	[ "$val" = none ] && val=""
	echo "$val"
}

nsa_bands() {
	at 'AT+QNWPREFCFG="nsa_nr5g_band"' | tr -d '\r' |
		sed -n 's/^+QNWPREFCFG: *"nsa_nr5g_band", *\([0-9:]*\).*/\1/p' | head -n1
}

# list minus every avoided band, ':'-separated, order kept
bands_without() {
	local list="$1" avoid="$2" out="" b a skip
	for b in $(echo "$list" | tr ':' ' '); do
		skip=0
		for a in $(echo "$avoid" | tr ':,' '  '); do
			[ "$b" = "$a" ] && skip=1
		done
		[ "$skip" = 1 ] || out="${out:+$out:}$b"
	done
	echo "$out"
}

# Was the NR carrier (as last seen by gl-cellular-atd) one of the avoided bands?
nr_band_implicated() {
	local seen a
	seen="$(cat /var/run/gl-cellular-nr-band 2>/dev/null)"
	seen="${seen#n}"
	[ -n "$seen" ] || return 1
	for a in $(echo "$1" | tr ':,' '  '); do
		[ "$seen" = "$a" ] && return 0
	done
	return 1
}

cmd_band_guard() {
	local action="$1" avoid cur new saved guarded hold up
	read -r up _ < /proc/uptime
	up="${up%%.*}"

	case "$action" in
	on)
		[ -f "$GUARD" ] && return 0
		avoid="$(guard_avoid)"
		[ -n "$avoid" ] || return 0
		nr_band_implicated "$avoid" || return 0
		cur="$(nsa_bands)"
		[ -n "$cur" ] || return 0
		new="$(bands_without "$cur" "$avoid")"
		# Nothing to remove, or it would leave no NR band at all.
		[ "$new" != "$cur" ] && [ -n "$new" ] || return 0
		# Both lists go to flash first: the modem keeps the reduced one in
		# its NV, so a reboot must still know what to put back.
		uci -q set gl-cellular.state.nsa_band_saved="$cur"
		uci -q set gl-cellular.state.nsa_band_guarded="$new"
		uci -q commit gl-cellular
		case "$(at "AT+QNWPREFCFG=\"nsa_nr5g_band\",$new")" in
		*OK*)
			echo "$up" > "$GUARD"
			logger -p daemon.warning -t "$TAG" \
				"SIM re-lock on NR $avoid: avoiding it for a while (nsa_nr5g_band $cur -> $new)"
			;;
		*)
			uci -q delete gl-cellular.state.nsa_band_saved
			uci -q delete gl-cellular.state.nsa_band_guarded
			uci -q commit gl-cellular
			;;
		esac
		;;
	release)
		[ -f "$GUARD" ] || return 0
		hold="$(uci -q get gl-cellular.watchdog.relock_avoid_hold_sec || echo 1800)"
		[ $((up - $(cat "$GUARD" 2>/dev/null || echo 0))) -ge "$hold" ] || return 0
		cmd_band_guard off
		;;
	off)
		saved="$(uci -q get gl-cellular.state.nsa_band_saved)"
		guarded="$(uci -q get gl-cellular.state.nsa_band_guarded)"
		if [ -n "$saved" ]; then
			cur="$(nsa_bands)"
			if [ -n "$guarded" ] && [ -n "$cur" ] && [ "$cur" != "$guarded" ]; then
				# The user changed the band lock meanwhile; theirs wins.
				logger -p daemon.notice -t "$TAG" \
					"NR band list changed during the guard ($cur); not restoring"
			else
				case "$(at "AT+QNWPREFCFG=\"nsa_nr5g_band\",$saved")" in
				*OK*)
					logger -p daemon.notice -t "$TAG" \
						"restored NR NSA band list ($saved)"
					;;
				*)
					# AT port not ready: keep the saved list, retry at the
					# next release/apply.
					logger -p daemon.warning -t "$TAG" \
						"could not restore NR NSA band list yet; will retry"
					return 1
					;;
				esac
			fi
			uci -q delete gl-cellular.state.nsa_band_saved
			uci -q delete gl-cellular.state.nsa_band_guarded
			uci -q commit gl-cellular
		fi
		rm -f "$GUARD"
		;;
	esac
}

cmd_show() {
	echo "configured=$(configured_pref)"
	echo "effective=$(current_pref)"
	fb="$(fallback_pref)"
	[ -n "$fb" ] && echo "fallback=$fb"
	at 'AT+QNWPREFCFG="nr5g_disable_mode"' | tr -d '\r'
	at 'AT+QENG="servingcell"' | tr -d '\r'
}

case "${1:-apply}" in
apply)   cmd_apply ;;
restore) cmd_restore ;;
fallback) cmd_fallback ;;
show)    cmd_show ;;
band-guard) cmd_band_guard "$2" ;;
*)
	echo "usage: $(basename "$0") {apply|restore|fallback|show|band-guard on|release|off}" >&2
	exit 1
	;;
esac