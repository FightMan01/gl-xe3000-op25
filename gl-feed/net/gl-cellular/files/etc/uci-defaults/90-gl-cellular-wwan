#!/bin/sh
# Cellular WAN interface: the modem's PCIe link driven by Quectel's pcie_mhi
# driver (kmod-pcie_mhi) and quectel-CM through the `qcm` netifd proto
# (/lib/netifd/proto/qcm.sh) - the same QMI/QMAP stack GL's stock firmware
# uses. Control node /dev/mhi_QMI0; data netdev rmnet_mhi0(.1).
#
# qcm creates the dynamic wwan_4 (dhcp) and wwan_6 (static) children that
# mwan3/kmwan, gl-cellular-atd and the watchdog track.
#
# An existing network.wwan (kept across a sysupgrade) that still points at
# the old mainline mbim/qmi protos is migrated in place; APN, PIN, metric and
# other user settings are preserved.

case "$(uci -q get network.wwan.proto)" in
	mbim|qmi)
		uci -q batch <<-EOT
			set network.wwan.proto='qcm'
			set network.wwan.device='/dev/mhi_QMI0'
			set network.wwan.ifname='rmnet_mhi0'
		EOT
		uci -q commit network
		exit 0
		;;
esac

[ -n "$(uci -q get network.wwan)" ] && exit 0

uci -q batch <<-EOT
	set network.wwan=interface
	set network.wwan.proto='qcm'
	set network.wwan.device='/dev/mhi_QMI0'
	set network.wwan.ifname='rmnet_mhi0'
	set network.wwan.apn='internet'
	# Telekom's internet APN provides the working IPv4 bearer used by
	# udhcpc on the RM520N-GL. Users can still select IPv4 & IPv6 in the UI.
	set network.wwan.pdptype='ipv4'
	set network.wwan.auto='1'
	set network.wwan.metric='20'
EOT
uci -q commit network

exit 0
