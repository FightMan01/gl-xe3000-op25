#!/bin/sh
# Re-apply the runtime-PM override whenever the modem PCI function (re)appears.
# `bind` fires after the driver probes, and a driver probe can re-enable
# runtime PM - so also re-apply a moment later to make the "on" stick,
# otherwise the modem autosuspends to D3 every few seconds again.

case "$ACTION" in
add|bind)
	/usr/sbin/gl-cellular-pcie-pm
	# Also apply the MHI transition-timeout override. The driver's default
	# is 3000ms for every wait in the MHI state machine, which is tight
	# enough that a slow channel start under load becomes a timed-out one -
	# and doing it here means it is right from the first data call rather
	# than only after a recovery that was already too late.
	/usr/sbin/gl-cellular-mhi-reset tune
	( sleep 3; /usr/sbin/gl-cellular-pcie-pm; /usr/sbin/gl-cellular-mhi-reset tune ) &
	;;
esac
