#!/bin/sh /etc/rc.common

START=99
STOP=01
USE_PROCD=1

# Opt-in (gl-cellular.cellpick.enabled=1); nothing runs otherwise.
start_service() {
	[ "$(uci -q get gl-cellular.cellpick.enabled)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/gl-cellular-cellpick
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger gl-cellular
}

stop_service() {
	[ "$(uci -q get gl-cellular.cellpick.owned)" = "1" ] || return 0
	ubus -t 8 call cellular.at command '{"cmd":"AT+QNWLOCK=\"common/4g\",0","timeout":5}' >/dev/null 2>&1
	uci -q set gl-cellular.cellpick.owned=0; uci commit gl-cellular
}
