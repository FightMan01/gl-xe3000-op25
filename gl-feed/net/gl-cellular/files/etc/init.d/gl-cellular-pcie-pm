#!/bin/sh /etc/rc.common

START=18
STOP=89

start() {
	# PCI/MHI probing finishes shortly after rcS reaches this service, and
	# the PCI driver probe can re-enable runtime PM.  Setting
	# power/control=on before that lands is overwritten back to "auto", after
	# which the modem autosuspends into D3 every few seconds (dmesg
	# "save config"/"PME#" churn) - the very thing this service exists to
	# prevent, and a known way to wedge the modem's MHI firmware.  Keep
	# re-applying well past probe instead of exiting as soon as the device
	# shows up; the PCI hotplug hook re-applies again on every later bind.
	(
		for delay in 0 1 2 3 5 8 13 21 34 55; do
			[ "$delay" -eq 0 ] || sleep "$delay"
			/usr/sbin/gl-cellular-pcie-pm
		done
	) &
}
