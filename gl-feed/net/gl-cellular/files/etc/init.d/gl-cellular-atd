#!/bin/sh /etc/rc.common
START=22
STOP=90

USE_PROCD=1

start_service() {
	[ -c "$(uci -q get gl-cellular.atport.dev)" ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/eco /usr/sbin/gl-cellular-atd
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
