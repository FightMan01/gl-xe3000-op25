#!/bin/sh /etc/rc.common

START=98
STOP=02
USE_PROCD=1

# Debug tracer, off unless gl-cellular.watchdog.relock_trace=1: it sends
# several AT commands every few seconds, which keeps the modem and its AT
# port busy for nothing on a healthy router. With the flag off no instance
# is created, so procd has nothing to respawn.
start_service() {
	[ "$(uci -q get gl-cellular.watchdog.relock_trace)" = "1" ] || return 0
	[ -e /var/run/gl-cellular-flashing ] && return 0

	procd_open_instance
	procd_set_param command /usr/sbin/gl-cellular-relock-trace
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
